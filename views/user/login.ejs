    <!-- ============ HERO / LOGIN ============ -->
    <main class="hero">
      <div class="hero-overlay">
        <img src="hero.png" alt="" aria-hidden="true" />
      </div>

      <main class="hero">
  <img class="hero-bg" src="images/hero1.png" alt="" />
  <div class="hero-overlay"></div>

  <div class="hero-content">
    <section class="login-card" aria-labelledby="loginTitle">

      <h1 id="loginTitle">Welcome Back</h1>
      <p class="subtitle">Welcome back to nohr. Please enter your details.</p>
          <form id="loginForm" novalidate>
            <!-- Email -->
            <div class="field">
              <label for="email">Email address</label>
              <div class="input-wrap">
                <svg
                  class="icon-left"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="5" width="18" height="14" rx="1.500" />
                  <path d="M3 7l9 6 9-6" />
                </svg>
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="your@email.com"
                  autocomplete="email"
                  required
                />
              </div>
              <p class="error" id="emailError" role="alert"></p>
            </div>

            <!-- Password -->
            <div class="field">
              <div class="label-row">
                <label for="password">Password</label>
                <a href="#" class="forgot">Forgot Password?</a>
              </div>
              <div class="input-wrap">
                <svg
                  class="icon-left"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                >
                  <rect x="5" y="11" width="14" height="9" rx="1.500" />
                  <path d="M8 11V8a4 4 0 018 0v3" />
                </svg>
                <input
                  type="password"
                  id="password"
                  name="password"
                  placeholder="••••••••"
                  autocomplete="current-password"
                  required
                  minlength="6"
                />
                <button
                  type="button"
                  class="input-toggle"
                  id="togglePass"
                  aria-label="Show password"
                >
                  <svg
                    class="eye-open"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path
                      d="M1.500 12S5.500 5 12 5s10.500 7 10.500 7-4 7-10.500 7S1.500 12 1.500 12z"
                    />
                    <circle cx="12" cy="12" r="3" />
                  </svg>
                  <svg
                    class="eye-closed"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M3 3l18 18" />
                    <path
                      d="M10.600 6.100A10 10 0 0112 6c6.500 0 10.500 6 10.500 6a17 17 0 01-3.200 3.800M6.600 7.500A17 17 0 001.500 12S5.500 18 12 18a9.700 9.700 0 004.200-.9"
                    />
                  </svg>
                </button>
              </div>
              <p class="error" id="passwordError" role="alert"></p>
            </div>

            <button type="submit" class="btn-login" id="loginBtn">
              <span class="btn-text">LOGIN</span>
            </button>

            <p class="form-message" id="formMessage" role="status"></p>
          </form>

          <div class="divider"><span>OR CONTINUE WITH</span></div>

          <button type="button" class="btn-google" id="googleBtn">
            <svg width="16" height="16" viewBox="0 0 48 48">
              <path
                fill="#EA4335"
                d="M24 9.500c3.500 0 6.600 1.200 9.100 3.600l6.800-6.800C35.800 2.400 30.300 0 24 0 14.600 0 6.500 5.400 2.600 13.200l7.900 6.100C12.400 13.600 17.700 9.500 24 9.500z"
              />
              <path
                fill="#4285F4"
                d="M46.500 24.500c0-1.600-.1-3.100-.4-4.500H24v9h12.700c-.6 3-2.200 5.500-4.700 7.200l7.600 5.900c4.400-4.100 6.900-10.100 6.900-17.600z"
              />
              <path
                fill="#FBBC05"
                d="M10.500 28.700A14.500 14.500 0 019.500 24c0-1.600.3-3.200.8-4.700l-7.900-6.100A24 24 0 000 24c0 3.900.9 7.500 2.600 10.800l7.900-6.100z"
              />
              <path
                fill="#34A853"
                d="M24 48c6.500 0 11.900-2.100 15.900-5.800l-7.600-5.900c-2.100 1.400-4.900 2.300-8.300 2.300-6.300 0-11.600-4.100-13.500-9.800l-7.900 6.100C6.500 42.600 14.600 48 24 48z"
              />
            </svg>
            GOOGLE
          </button>

          <p class="signup">
        Don't have an Account? <a href="signup.html">Create Account</a>
      </p>
