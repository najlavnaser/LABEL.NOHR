        </button>
        <button class="action" aria-label="Wishlist">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M12 20.5s-8-4.7-8-10.6A4.4 4.4 0 018.4 5.500c1.500 0 2.800.8 3.600 2 .8-1.200 2.100-2 3.600-2A4.400 4.400 0 0120 9.900c0 5.900-8 10.600-8 10.600z"/></svg>
