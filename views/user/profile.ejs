<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>My Profile – nohr.</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="profile.css">
</head>
<body>

<!-- Icon sprite -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></symbol>
  <symbol id="i-bag" viewBox="0 0 24 24"><path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></symbol>
  <symbol id="i-heart" viewBox="0 0 24 24"><path d="M12 20s-8-5-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 9c0 6-8 11-8 11z"/></symbol>
  <symbol id="i-gear" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1"/></symbol>
  <symbol id="i-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l6 6"/></symbol>
  <symbol id="i-logout" viewBox="0 0 24 24"><path d="M9 4H5v16h4M16 8l4 4-4 4M20 12H9"/></symbol>
  <symbol id="i-pencil" viewBox="0 0 24 24"><path d="M4 20l1-5L16 4l4 4L9 19l-5 1z"/></symbol>
  <symbol id="i-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 6l9 7 9-7"/></symbol>
  <symbol id="i-card" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="11" r="2"/><path d="M6 17c0-2 1.5-3 3-3s3 1 3 3M15 9h3M15 13h3"/></symbol>
  <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></symbol>
  <symbol id="i-home" viewBox="0 0 24 24"><path d="M3 11l9-8 9 8M5 10v10h14V10M10 20v-6h4v6"/></symbol>
  <symbol id="i-building" viewBox="0 0 24 24"><path d="M5 21V3h10v18M15 9h4v12M9 7h2M9 11h2M9 15h2M3 21h18"/></symbol>
  <symbol id="i-phone" viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z"/></symbol>
  <symbol id="i-truck" viewBox="0 0 24 24"><path d="M2 6h12v10H2zM14 10h4l3 3v3h-7M6 19a2 2 0 1 0 0-.01M17 19a2 2 0 1 0 0-.01"/></symbol>
  <symbol id="i-trash" viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></symbol>
  <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
  <symbol id="i-chevron" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></symbol>
</svg>

<div class="page">

  <!-- Header -->
  <header class="site-header">
    <a class="logo" href="#">
      <span class="logo-mark">nohr.</span>
      <span class="logo-tag">A Homegrown Label.</span>
    </a>
    <nav class="main-nav" aria-label="Main">
      <a href="homepage.html" class="is-active">Home</a>
      <a href="#">New In</a>
      <a href="#" class="has-caret">Categories <svg class="icon icon-xs"><use href="#i-chevron"/></svg></a>
      <a href="#">Sale</a>
      <a href="#">About</a>
    </nav>
    <div class="header-actions">
      <button class="search-btn" type="button"><svg class="icon"><use href="#i-search"/></svg> Search</button>
      <a href="#" aria-label="Account"><svg class="icon icon-lg"><use href="#i-user"/></svg></a>
      <a href="#" aria-label="Bag"><svg class="icon icon-lg"><use href="#i-bag"/></svg></a>
      <a href="#" aria-label="Wishlist"><svg class="icon icon-lg"><use href="#i-heart"/></svg></a>
    </div>
  </header>

  <div class="layout">

    <!-- Sidebar -->
    <aside class="sidebar">
      <h2 class="sidebar-title">My Profile</h2>
      <nav class="side-nav" aria-label="Account">
        <a href="#" class="is-active" aria-current="page"><svg class="icon"><use href="#i-user"/></svg> Profile</a>
        <a href="#"><svg class="icon"><use href="#i-bag"/></svg> Orders</a>
        <a href="#"><svg class="icon icon-lg"><use href="#i-heart"/></svg> Wishlist</a>
        <a href="#"><svg class="icon icon-lg"><use href="#i-gear"/></svg> Settings</a>
      </nav>
      <div class="sidebar-foot">
        <div class="mini-user">
          <span class="mini-avatar" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="5"/><path d="M2 24c0-6 4.5-9 10-9s10 3 10 9z"/></svg></span>
          <span><strong>User</strong><small>Location</small></span>
        </div>
        <a href="login.html" class="logoutBtn"><svg class="icon icon-lg"><use href="#i-logout"/></svg> Logout</a>
      </div>
    </aside>

    <!-- Main -->
    <main class="content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="homepage.html">Home</a>><strong>My Profile</strong>
      </nav>
      <h1 class="page-title">My Profile</h1>
      <p class="page-sub">Manage your personal identity, login credentials, and delivery addresses.</p>

      <!-- Identity card -->
      <section class="card identity">

            <!-- Profile Image -->
        <div class="profile-pic-container">
          <img src="images/defaultProfile.jpg" id="profile-img" alt="Profile Picture">
          <input type="file" id="file-input" accept="image/*" onchange="previewImage(event)">
          <span class="imageText">Change Photo</span></label>
        </div>


        <div class="identity-info">
          <div class="name-row">
            <h2 id="profileName">User</h2>
            <span class="badge badge-green">Verified</span>
          </div>
          <p class="member" id="memberSince">Member since </p>
          <p class="email"><svg class="icon icon-xs"><use href="#i-mail"/></svg><span id="profileEmail">Loading..</span></p>
        </div>
        <button class="btn btn-outline btn-edit-profile" onclick="window.location.href='editProfile.html'" type="button"><svg class="icon icon-sm"></svg><span>Edit<br>Profile</span></button>
      </section>

      <!-- Details + Security -->
      <div class="grid-2">
        <section class="card info-card">
          <header class="card-head">
            <h3><svg class="icon icon-lg"><use href="#i-card"/></svg> Personal Details</h3>
          </header>
          <dl class="fields">
            <div><dt>Full name</dt><dd id="detailName">Username....</dd></div>
            <div><dt>Phone number</dt><dd id="detailPhone">Not added</dd></div>
           <div><dt>Gender</dt><dd id="detailGender">Not added</dd></div>

          </dl>
        </section>

        <section class="card info-card">
          <header class="card-head">
            <h3><svg class="icon icon-lg"><use href="#i-shield"/></svg> Login &amp; Security</h3>
          </header>
          <div class="sec-row">
            <div>
              <span class="label">Primary email address</span>
              <p class="sec-value" id="securityEmail">Loading...</p>
              <p class="hint">Verified for primary order invoices and login authentication</p>
            </div>
          </div>
          <div class="sec-row sec-row-pw">
            <div>
              <span class="label">Account password</span>
              <p class="dots" aria-label="Password hidden">••••••••••••</p>
              <p class="hint">Last updated 3 months ago (Requires minimum 10 characters)</p>
            </div>

          </div>
        </section>
      </div>

      <!-- Addresses -->
      <div class="section-head">
        <div>
          <h2>Saved Addresses</h2>
        </div>
        <button class="btn btn-solid" type="button"><svg class="icon icon-sm"><use href="#i-plus"/></svg> Add new address</button>
      </div>

      <div class="grid-2">
        <article class="card address is-default">
          <header class="card-head">
            <h3 class="addr-title"><svg class="icon"><use href="#i-home"/></svg> Primary Residence</h3>
            <span class="badge badge-dark">Default shipping</span>
          </header>
          <address>
            <strong>Alex Rivers</strong>
            124 Forest Hill Road, Apt 302<br>Portland, Oregon 97201<br>United States
          </address>
          <p class="phone"><svg class="icon icon-xs"><use href="#i-phone"/></svg> +1 (555) 000-0000</p>
          <footer class="addr-actions">
            <button class="link-btn" type="button"><svg class="icon icon-xs"><use href="#i-pencil"/></svg> Edit</button>
            <button class="link-btn muted" type="button"><svg class="icon icon-xs"><use href="#i-trash"/></svg> Remove</button>
          </footer>
        </article>

        <article class="card address">
          <header class="card-head">
            <h3 class="addr-title"><svg class="icon"><use href="#i-home"/></svg> Primary Residence</h3>
            <button class="link-btn muted" type="button">Set as default</button>
          </header>
          <address>
            <strong>Alex Rivers (Design Studio)</strong>
            742 Evergreen Terrace, Suite 4B<br>Springfield, OR 97477<br>United States
          </address>
          <p class="phone"><svg class="icon icon-xs"><use href="#i-phone"/></svg> +1 (555) 234-5678</p>
          <footer class="addr-actions">
              <button class="link-btn" type="button"><svg class="icon icon-xs"><use href="#i-pencil"/></svg> Edit</button>
              <button class="link-btn muted" type="button"><svg class="icon icon-xs"><use href="#i-trash"/></svg> Remove</button>
            
          </footer>
        </article>
      </div>
    </main>
  </div>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="logo-mark">nohr.</span>
        <p>A Homegrown Label.</p>
      </div>
      <div>
        <h4>Collections</h4>
        <ul><li><a href="#">All Collections</a></li><li><a href="#">Kurtas</a></li><li><a href="#">Dresses</a></li><li><a href="#">Sarees</a></li></ul>
      </div>
      <div>
        <h4>Support</h4>
        <ul><li><a href="#">Shipping</a></li><li><a href="#">Returns</a></li><li><a href="#">Contact</a></li><li><a href="#">Privacy</a></li></ul>
      </div>
      <div class="footer-social">
        <h4>Social</h4>
        <div class="social-icons">
          <a href="#" aria-label="Facebook"><svg viewBox="0 0 24 24"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H7v4h3v8h4v-8h3l1-4h-4V8z"/></svg></a>
          <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" class="stroke"><rect x="4" y="4" width="16" height="16" rx="5"/><circle cx="12" cy="12" r="3.5"/></svg></a>
          <a href="#" aria-label="X"><svg viewBox="0 0 24 24"><path d="M4 4l6.5 9L4 20h2l5.4-6 4.1 6H20l-6.8-9.4L19.4 4h-2l-5 5.6L8.5 4H4z"/></svg></a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2024 nohr. All Rights Reserved.</span>
      <a href="#">Terms of Service</a>
    </div>
  </footer>

</div>
<script src="/profile.js"></script>
</body>
</html>