<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>nohr. | A Homegrown Label</title>
  <meta name="description" content="Refining the daily wardrobe with sustainable materials and architectural precision." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="homepage.css" />
</head>
<body>

  <!-- HEADER -->
  <%- include('../partials/user-header') %>

  <div class="search-bar" id="searchBar" hidden>
    <input type="search" placeholder="Search kurtas, dresses, sarees..." aria-label="Search products" />
  </div>

  <main>
    <!-- HERO -->
    <section class="hero-wrap">
      <div class="hero">
        <img src="images/hero.png" alt="Model wearing a dark dress and mustard shawl in a forest" class="hero-img" data-fallback="hero" />
        <div class="hero-overlay"></div>
        <div class="hero-content">
          <h1>Wear the<br />Story.</h1>
          <p>Refining the daily wardrobe with sustainable materials and architectural precision. Designed for the conscious individual.</p>
          <div class="hero-btns">
            <a href="#signature" class="btn btn-solid">SHOP NOW</a>
            <a href="#signature" class="btn btn-outline">NEW ARRIVALS</a>
          </div>
        </div>
        <div class="hero-watermark" aria-hidden="true"><img class="hero-logo" src="images/logo-black.png"></div>
      </div>
    </section>

    <!-- COLLECTIONS -->
    <section class="collections" id="collections">
      <h2>Curated Collections</h2>
      <p class="sub">Elevate your everyday style.</p>
      <a href="#" class="view-all">View All Categories</a>

      <div class="collection-grid">
        <a href="#" class="collection-item">
          <div class="circle"><img src="images/kurtas.jpg" alt="Kurtas" data-fallback="kurtas" /></div>
          <h3>KURTAS</h3>
          <span>Tailored Resilience</span>
        </a>
        <a href="#" class="collection-item">
          <div class="circle"><img src="images/dresses.jpg" alt="Dresses" data-fallback="dresses" /></div>
          <h3>DRESSES</h3>
          <span>Fluid Architecture</span>
        </a>
        <a href="#" class="collection-item">
          <div class="circle"><img src="images/sarees.jpg" alt="Sarees" data-fallback="sarees" /></div>
          <h3>SAREES</h3>
          <span>Refined Detail</span>
        </a>
      </div>
    </section>

    <!-- SIGNATURE PIECES -->
    <section class="signature" id="signature">
      <h2>Signature Pieces</h2>
      <div class="title-rule"></div>
      <div class="product-grid" id="productGrid"></div>
    </section>

    <!-- NEWSLETTER -->
    <section class="newsletter-wrap">
      <div class="newsletter">
        <h2>Get 10% off Your First Order!</h2>
        <p>Subscribe to get special offers, free giveaways and once-in-a-lifetime deals.</p>
        <form id="newsletterForm" novalidate>
          <input type="email" id="emailInput" placeholder="Email Address" aria-label="Email address" required />
          <button type="submit">SUBSCRIBE</button>
        </form>
        <p class="form-msg" id="formMsg" role="status" aria-live="polite"></p>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <%- include('../partials/user-footer') %>

  <script src="homepage.js"></script>
</body>
</html>